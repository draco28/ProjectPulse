# ============================================================================
# Moksha DevHub - Git Ignore Configuration
# ============================================================================

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Backup of environment files (may contain passwords)
.env.backup
.env.old

# Production environment (Sprint 11 - contains secrets)
.env.prod-local

# MCP configuration (contains bearer tokens)
.mcp.json

# ============================================================================
# DEPENDENCIES
# ============================================================================
node_modules/
.pnp
.pnp.js

# pnpm
.pnpm-debug.log*
.pnpm-store/

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================================================
# NEXT.JS
# ============================================================================
.next/
out/
build/
dist/

# Next.js build output
.vercel

# Next.js cache
.cache/

# Static export
.next/static/

# ============================================================================
# TESTING
# ============================================================================
coverage/
*.lcov
.nyc_output

# Jest
jest-cache/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# ============================================================================
# TYPESCRIPT
# ============================================================================
*.tsbuildinfo
next-env.d.ts

# ============================================================================
# PRISMA
# ============================================================================
# Prisma client is generated, don't commit
# (but DO commit migrations/ folder)

# Prisma schema backups
*.prisma.backup
*.prisma.bak

# ============================================================================
# UPLOADS & USER DATA
# ============================================================================
uploads/
*.log

# Backup files
backups/
*.sql.gz
*.sql.bak

# ============================================================================
# DOCKER
# ============================================================================
# Don't ignore docker-compose.yml or Dockerfile
# But ignore Docker volumes data if locally mounted
postgres_data/

# ============================================================================
# IDE / EDITORS
# ============================================================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#

# ============================================================================
# OPERATING SYSTEM
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

