# TEMPORARY FILES
# ============================================================================
*.tmp
*.temp
*.cache
*.pid
*.seed
*.pid.lock
nul

# ============================================================================
# LOGS
# ============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================================
# MCP SERVER
# ============================================================================
apps/mcp-server/dist/
apps/mcp-docker/dist/

# ============================================================================
# CLAUDE CODE / AI ASSISTANTS
# ============================================================================
# Keep .claude/ directory (agents, skills)
# But ignore temporary analysis files and session state
.claude/state/current_session.json
.claude/state/history/*.json
.claude/gemini-analysis/*.md
!.claude/gemini-analysis/.gitkeep

# Python cache
__pycache__/
*.pyc

# Duplicate directories (artifacts)
.claude/.claude/
.playwright-mcp/.playwright-mcp/

# Playwright screenshots (testing artifacts)
.playwright-mcp/*.png

# Gemini integration (experimental)
.gemini/
.geminiignore
GEMINI.md
Gemini*.md
analyze-with-gemini.*
.claude/SETUP_COMPLETE.md
SIMPLE_GEMINI_WORKFLOW.md

# Keep .agent/gemini/ instruction files, but ignore audit outputs
!.agent/gemini/
!.agent/gemini/*.md
.agent/gemini/documentation-audit-202*.md

# ============================================================================
# SECURITY & SENSITIVE DATA
# ============================================================================
# Private keys
*.pem
*.key
*.p12
*.pfx

# Certificates
*.crt
*.cer

# Secrets
secrets/
*.secret

# Database dumps (may contain sensitive data)
*.dump
*.sql
!scripts/init-db.sql
!apps/web/prisma/migrations/**/*.sql
!apps/web/prisma/migrations-archive/**/*.sql
!apps/web/prisma/data-migrations/**/*.sql

# ============================================================================
# MISC
# ============================================================================
# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# Local config overrides
config.local.js
config.local.json

# Debug output
debug/
.debug/

# Reference templates (not part of project)
Starter_template/

