# ============================================================================
# ProjectPulse - Environment Configuration Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all YOUR_* placeholders with actual values
# 3. NEVER commit .env to git (already in .gitignore)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL User (default: projectpulse)
POSTGRES_USER=projectpulse

# PostgreSQL Password
# SECURITY REQUIREMENT: 16+ characters, mixed case, numbers, symbols
# Example: Pr0j3ctPuls3!2025SecureP@ss
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# PostgreSQL Database Name
POSTGRES_DB=projectpulse_db

# Database URL for Prisma
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Docker: Use service name 'postgres' as host
# For local development: Use 'localhost'
DATABASE_URL=postgresql://projectpulse:YOUR_SECURE_PASSWORD_HERE@postgres:5432/projectpulse_db

# Optional: Direct connection URL (when connecting from host machine, not Docker)
# DATABASE_URL=postgresql://projectpulse:YOUR_PASSWORD@localhost:5432/projectpulse_db

# PostgreSQL Connection Limits (prevent resource exhaustion)
POSTGRES_MAX_CONNECTIONS=100

# ============================================================================
# NEXT.JS APPLICATION
# ============================================================================

# Application Environment (development, production, test)
NODE_ENV=development

# Public App URL (used for CORS, webhooks, absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port for Next.js dev server (default: 3000)
PORT=3000

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# Enable/Disable MCP Server for Claude Code integration
MCP_SERVER_ENABLED=true

# MCP Server API URL (internal Docker network)
MCP_API_URL=http://web:3000/api

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Maximum file upload size in bytes (default: 10MB)
# 10MB = 10485760 bytes
UPLOAD_MAX_SIZE_MB=10

# Allowed MIME types for uploads (comma-separated)
# Default: images, PDFs, text files, JSON
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/markdown,application/json

# Uploads directory (relative to project root)
UPLOADS_DIR=./uploads

# ============================================================================
# MOKSHA PROJECT INTEGRATION
# ============================================================================

# Path to Moksha Mythic Clash Unreal Engine project
# Used for file linking and code analysis features
# Example: F:/Game_Projects/Moksha/MokshaMythicClash
MOKSHA_PROJECT_ROOT=YOUR_MOKSHA_PROJECT_PATH_HERE

# ============================================================================
# SEARCH CONFIGURATION (Dynamic - Stored in Database via Settings Model)
# ============================================================================
# These are default values if not set in database
# Use Settings UI or getSetting() utility to change at runtime

# Full-text search weight (0.0 to 1.0, default: 0.6)
# SEARCH_FULLTEXT_WEIGHT=0.6

# Semantic search weight (0.0 to 1.0, default: 0.4)
# SEARCH_SEMANTIC_WEIGHT=0.4

# Minimum semantic similarity threshold (0.0 to 1.0, default: 0.7)
# SEARCH_SEMANTIC_THRESHOLD=0.7

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# MCP Internal Service Secret (Sprint 17 - Ticket #129)
# Shared secret for MCP server <-> Web API internal communication
# REQUIRED: Must be set in BOTH web and mcp-server environments
# Generate with: openssl rand -hex 32
MCP_INTERNAL_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE

# Allowed commands for process execution (comma-separated)
# Used by secure process executor (lib/process-executor.ts)
# SECURITY: Only add commands you explicitly need. No shell metacharacters allowed.
ALLOWED_COMMANDS=git,pnpm,npm,node,docker,python

# Process execution timeout (milliseconds, default: 60000 = 60 seconds)
PROCESS_TIMEOUT=60000

# Maximum process output size (bytes, default: 1MB)
PROCESS_MAX_OUTPUT_SIZE=1048576

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=debug

# Enable structured JSON logging (true/false)
LOG_JSON=false

# ============================================================================
# OPTIONAL: ANALYTICS & TELEMETRY
# ============================================================================

# Disable Next.js telemetry (recommended for privacy)
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Prisma Studio port (default: 5555)
# PRISMA_STUDIO_PORT=5555

# Enable React strict mode (recommended: true)
# NEXT_PUBLIC_STRICT_MODE=true

# Enable source maps in production (debugging, but increases bundle size)
# GENERATE_SOURCEMAP=false

# ============================================================================
# FUTURE FEATURES (Phase 2+)
# ============================================================================

# GitHub Integration (optional)
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPO=username/repo-name

# Semgrep Security Scanning (optional)
# SEMGREP_API_KEY=your_semgrep_api_key

# Agent Persona System (optional)
# ENABLE_AGENT_PERSONAS=true

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
