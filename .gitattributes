# ============================================================================
# Moksha DevHub - Git Attributes Configuration
# ============================================================================
# Ensures consistent line endings across Windows, Mac, and Linux
# ============================================================================

# Auto detect text files and normalize line endings to LF
* text=auto

# ============================================================================
# SOURCE CODE - Force LF line endings
# ============================================================================

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# JSON
*.json text eol=lf
*.jsonc text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf

# Markdown & Documentation
*.md text eol=lf
*.mdx text eol=lf

# SQL
*.sql text eol=lf
*.prisma text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf

# ============================================================================
# WINDOWS BATCH FILES - Force CRLF
# ============================================================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================================
# BINARY FILES - Do not modify
# ============================================================================

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# Media
*.mp4 binary
*.mp3 binary
*.wav binary
*.avi binary
*.mov binary

# ============================================================================
# LINGUIST OVERRIDES (GitHub language detection)
# ============================================================================

# Exclude generated files from statistics
*.generated.* linguist-generated=true
**/node_modules/* linguist-vendored
**/.next/* linguist-generated
**/dist/* linguist-generated
**/build/* linguist-generated
**/coverage/* linguist-generated
**/*.min.js linguist-generated
**/*.min.css linguist-generated

# Mark documentation
*.md linguist-documentation

# ============================================================================
# GIT DIFF SETTINGS
# ============================================================================

# Use better diff driver for package-lock.json
package-lock.json -diff

# Mark generated files as binary (don't show diffs)
*.lock binary
pnpm-lock.yaml binary
