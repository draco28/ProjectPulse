# ProjectPulse Production Environment Variables
# Copy this file to .env.production and update with your values

# Database Configuration
POSTGRES_USER=projectpulse
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=projectpulse_prod
DATABASE_URL=postgresql://projectpulse:changeme_secure_password@postgres:5432/projectpulse_prod

# Redis Configuration
REDIS_PASSWORD=changeme_secure_redis_password

# Application Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com
DEFAULT_PROJECT_ID=1

# Port Configuration (optional, defaults shown)
NEXTJS_PORT=3000
MCP_PORT=3001

# Node Environment
NODE_ENV=production
