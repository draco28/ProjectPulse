# ProjectPulse Python MCP Server Configuration
# Copy to .env and adjust values for your environment

# === API Connection ===
# Dev local:     http://localhost:3000/api
# Dev Docker:    http://nextjs:3000/api
# Prod Docker:   http://prod-nextjs:3000/api
PROJECTPULSE_API_BASE_URL=http://localhost:3000/api

# Required in production, optional in development
PROJECTPULSE_API_TOKEN=

# Server port (default: 3002)
MCP_SERVER_PORT=3002

# Environment: development | production | test
NODE_ENV=development

# === Tool Profile System ===
# Comma-separated: core, onboarding, admin, utility, observability
# Default: core (~48 tools for daily work)
TOOL_PROFILES=core

# === Security ===
# HMAC secret for admin API calls (must match MCP_INTERNAL_SECRET in web app)
MCP_INTERNAL_SECRET=

# CORS origins (comma-separated, empty = allow all in dev)
# Prod example: https://projectpulse.dracodev.dev,https://projectpulsemcp-py.dracodev.dev
ALLOWED_ORIGINS=

# === Logging ===
# debug | info | warning | error
LOG_LEVEL=info
