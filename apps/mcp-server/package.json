{
  "name": "@devhub/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectPulse MCP server (stdio transport) that bridges Claude Code tools to Next.js APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index-http.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/__tests__/**/*.test.ts src/tools/__tests__/**/*.test.ts"
  },
  "keywords": [
    "projectpulse",
    "mcp",
    "claude",
    "devhub"
  ],
  "author": "ProjectPulse",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@prisma/client": "^5.9.1",
    "@projectpulse/roadmap-tools": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.20.6",
    "typescript": "^5.4.2"
  }
}
