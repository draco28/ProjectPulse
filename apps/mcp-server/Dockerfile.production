# Single-stage production build
# This approach mirrors the dev environment to ensure pnpm symlinks work correctly.
# The image is larger but guaranteed to work with workspace dependencies + Prisma.

FROM node:20-alpine

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files first (for better caching)
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY apps/web/package.json ./apps/web/
COPY packages/roadmap-tools/package.json ./packages/roadmap-tools/

# Install dependencies (symlinks work within the same filesystem)
RUN pnpm install --frozen-lockfile

# Copy source files
COPY apps/mcp-server ./apps/mcp-server
COPY apps/web/prisma ./apps/web/prisma
COPY packages/roadmap-tools ./packages/roadmap-tools
COPY tsconfig.base.json ./

# Generate Prisma client (run from web app where prisma is installed)
RUN cd apps/web && pnpm exec prisma generate

# Build shared packages
RUN pnpm --filter @projectpulse/roadmap-tools build

# Build MCP server
RUN pnpm --filter @devhub/mcp-server build

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S mcp -u 1001
USER mcp

# Set production environment
ENV NODE_ENV=production
ENV PORT=3001
ENV MCP_PORT=3001

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "apps/mcp-server/dist/index-http.js"]
