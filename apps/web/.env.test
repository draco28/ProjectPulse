# Test Environment Variables
# Used for integration tests
#
# The infra-config package automatically detects 'test' environment
# when NODE_ENV=test or running under Jest/Vitest

PROJECTPULSE_ENV=test
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/projectpulse_test"
NEXTAUTH_SECRET="test-secret"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="test"

# Playwright E2E Tests - defaults to localhost:3000
# Override with PROJECTPULSE_WEB_URL if testing against remote
BASE_URL="http://localhost:3000"

# Health Dashboard - Use project ID 8 (current seeded project)
DEFAULT_PROJECT_ID="8"
