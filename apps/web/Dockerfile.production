# Stage 1: Dependencies
FROM node:20-bullseye-slim AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/roadmap-tools/package.json ./packages/roadmap-tools/
RUN corepack enable && pnpm install --frozen-lockfile

# Stage 2: Build shared packages
FROM node:20-bullseye-slim AS shared-builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY packages/roadmap-tools ./packages/roadmap-tools
RUN node node_modules/typescript/lib/tsc.js -p packages/roadmap-tools

# Stage 3: Build Next.js
FROM node:20-bullseye-slim AS builder
WORKDIR /app

# Copy all node_modules (including pnpm symlink structure)
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules

# Copy built shared packages
COPY --from=shared-builder /app/packages/roadmap-tools/dist ./packages/roadmap-tools/dist
COPY --from=shared-builder /app/packages/roadmap-tools/package.json ./packages/roadmap-tools/

# Copy source files
COPY apps/web ./apps/web
COPY packages/roadmap-tools/src ./packages/roadmap-tools/src
COPY packages/roadmap-tools/tsconfig.json ./packages/roadmap-tools/
COPY tsconfig.base.json ./tsconfig.base.json
COPY .eslintrc.json ./.eslintrc.json

# Generate Prisma client (must be done BEFORE next build)
RUN cd apps/web && node node_modules/prisma/build/index.js generate

# Copy generated prisma client to root node_modules for roadmap-tools package
RUN mkdir -p node_modules/@prisma && \
    cp -r node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/@prisma/client node_modules/@prisma/ && \
    cp -r node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma node_modules/.prisma

# Build Next.js
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd apps/web && node node_modules/next/dist/bin/next build

# Stage 4: Production runtime
FROM node:20-bullseye-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy Next.js standalone build
# IMPORTANT: Static files must be relative to server.js, not in monorepo structure
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./public

# Copy pnpm node_modules (the standalone build has symlinks pointing to /node_modules/.pnpm)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.pnpm /node_modules/.pnpm

# Copy shared package
COPY --from=builder --chown=nextjs:nodejs /app/packages/roadmap-tools/dist ./packages/roadmap-tools/dist
COPY --from=builder --chown=nextjs:nodejs /app/packages/roadmap-tools/package.json ./packages/roadmap-tools/

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check - verify app is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
