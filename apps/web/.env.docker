# Docker Development Environment
# Used when running the app in Docker containers
#
# The infra-config package uses PROJECTPULSE_ENV to select the right preset

PROJECTPULSE_ENV=dev
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/projectpulse_dev"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
