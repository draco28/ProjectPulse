// Prisma schema for ProjectPulse (Sprint Tracking System)
// Database: PostgreSQL 16
// Features: JSONB, Full-text search, Vector embeddings, Sprint Hierarchy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SPRINT HIERARCHY (2-LEVEL ROADMAP STRUCTURE)
// ============================================================================
// Architecture: Adjacency List (FK relationships)
// Progress: Stored field with application-managed roll-up
// Query Strategy: Prisma nested includes for tree traversal
// Sprint 15 Ticket #80: Simplified to Phase → Sprint only (removed Week/Day for Kanban UI)
// Sprint 12 Redesign: Removed Task/Session/Checkpoint (unused)

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

model Phase {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent (Sprint 8.5: Link to Roadmap after materialization)
  roadmapId String?
  roadmap   Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  // Hierarchy - Children (Sprint 15: 2-level only)
  sprints Sprint[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([roadmapId]) // Sprint 8.5: Query phases by roadmap
  @@index([startDate, endDate])
  @@index([status])
  @@index([startDate, endDate, status])
  @@map("phases")
}

// Sprint 15: 2-level hierarchy (Phase → Sprint)
model Sprint {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Sprint 15: Sprint number within phase for ticket correlation
  sprintNumber Int // 1, 2, 3, ... (set during materialization)

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  // Sprint 15: Tickets assigned to this sprint (FK relationship)
  tickets Ticket[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@unique([phaseId, sprintNumber]) // Sprint 15: Ensure uniqueness per phase
  @@index([phaseId])
  @@index([phaseId, startDate]) // Composite index recommended by prisma-expert
  @@index([phaseId, sprintNumber]) // Sprint 15: Fast lookup by sprint number
  @@index([startDate, endDate])
  @@index([status])
  @@index([phaseId, status])
  @@index([phaseId, startDate, endDate, status])
  @@map("sprints")
}

// Sprint 15: Week and Day models REMOVED (Ticket #80)
// Roadmap simplified to 2-level: Phase → Sprint
// Tickets now link directly to Sprint via sprintId FK
// Progress cascades: Ticket status → Sprint % → Phase %

// ============================================================================
// USER PREFERENCES (for theme system and future UI preferences)
// ============================================================================

model UserPreferences {
  id     Int  @id @default(autoincrement())
  userId Int? @unique // Optional: will be linked to User model when auth is added

  // Theme preferences
  theme String @default("desert") // "desert", "neon", "earthy", "coral"

  // UI preferences (future)
  sidebarCollapsed Boolean @default(false)
  compactMode      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([theme])
  @@map("user_preferences")
}

// ============================================================================
// CORE ENTITIES: PROJECT & ISSUES
// ============================================================================

model Project {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text
  repository  String? // Git repository URL

  // Sprint 8.9: User ownership
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tickets            Ticket[] // Sprint 10: Unified Ticket model (replaces Issue)
  skills             Skill[] // Sprint 6: Skills lazy-loading system
  onboardingSessions OnboardingSession[]
  workflowRuns       WorkflowRun[]
  workflowTemplates  WorkflowTemplate[] // Sprint 8.5 Phase 3: Project-scoped workflow templates
  healthScanners     HealthScanner[] // Sprint 7: Health monitoring system
  healthScores       HealthScore[] // Sprint 7: Health scores
  roadmap            Roadmap? // Sprint 8.5: Development roadmap (one-to-one)
  agentPersonas      AgentPersona[] // Sprint 8.5 Phase 3: Project-scoped agent personas
  sops               SOP[] // Sprint 8.5 Phase 3E: SOPs for this project
  agentSessions      AgentSession[] // Sprint 12: Agent work sessions (replaces DevelopmentSession)

  // Sprint 8.9: Additional project-scoped entities
  knowledgeItems   KnowledgeItem[]
  securityFindings SecurityFinding[]
  wikiPages        WikiPage[]

  // Sprint 9: Agent OAuth & Settings
  tokens        ProjectToken[]
  mcpWriteFiles Boolean        @default(false) // Allow MCP to write helper files (CLAUDE.md, AGENTS.md) to repo

  // Sprint 9: Memory Bank System
  memoryBanks MemoryBank[]

  // Sprint 11.7: Project-scoped labels (moved from global)
  labels Label[]

  // Sprint 11.7: Project-scoped milestones
  milestones Milestone[]

  // Sprint 14: Backlog items for traceability
  backlogItems BacklogItem[]

  // Sprint 11.5: MCP Tool Logging for Admin Dashboard
  toolLogs       MCPToolLog[]
  toolAggregates MCPToolAggregate[]

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  OnboardingPromptTemplate OnboardingPromptTemplate[]

  @@index([name])
  @@index([ownerId])
}

// ============================================================================
// AGENT OAUTH & PROJECT SETTINGS (Sprint 9)
// ============================================================================
// Purpose: Project-scoped agent bearer tokens for MCP access
// Security: Opaque tokens (hashed with bcrypt), validated per request
// Multi-tenancy: Each project can have multiple agent tokens (per persona/client)

model ProjectToken {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String // Human-friendly label (e.g., "Frontend Claude", "Backend Claude")
  tokenHash  String // bcrypt hash of opaque token (plaintext never stored)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)

  // Sprint 10: Tool-level permissions for fine-grained access control
  // blockedTools: Tools this token is NOT allowed to execute (e.g., ["admin_deleteProject"])
  // allowedTools: If non-empty, ONLY these tools can be executed (whitelist mode)
  blockedTools String[] @default([])
  allowedTools String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sprint 11.5: MCP Tool Logging relation
  toolLogs MCPToolLog[]

  @@unique([projectId, name]) // One token per name per project
  @@index([projectId, isRevoked, expiresAt]) // Fast validation queries
  @@map("project_tokens")
}

// ============================================================================
// MCP TOOL LOGGING (Sprint 11.5)
// ============================================================================
// Purpose: Track all MCP tool invocations for admin monitoring
// Architecture: Individual logs + daily aggregates for efficient analytics
// Retention: Logs kept 30 days, aggregates kept indefinitely

// Individual tool call records - high volume, short retention
model MCPToolLog {
  id        BigInt   @id @default(autoincrement())
  tokenId   Int
  projectId Int
  toolName  String   @db.VarChar(100)
  duration  Int // Execution time in milliseconds
  success   Boolean
  error     String?  @db.Text
  metadata  Json?    @db.JsonB // Request params (sanitized, no secrets)
  createdAt DateTime @default(now())

  token   ProjectToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([projectId])
  @@index([toolName])
  @@index([createdAt(sort: Desc)])
  @@index([success])
  @@index([projectId, createdAt]) // For project-specific time-series queries
  @@map("mcp_tool_logs")
}

// Daily aggregated statistics - permanent retention for analytics
model MCPToolAggregate {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  projectId   Int
  toolName    String   @db.VarChar(100)
  callCount   Int      @default(0)
  errorCount  Int      @default(0)
  avgDuration Int      @default(0) // Average milliseconds
  minDuration Int      @default(0)
  maxDuration Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([date, projectId, toolName])
  @@index([date(sort: Desc)])
  @@index([projectId])
  @@map("mcp_tool_aggregates")
}

// ============================================================================
// ONBOARDING SYSTEM
// ============================================================================
// Sprint 2 Week 4: 3-session guided project initialization
// Sessions: 1=Executive Summary, 2=Industry Docs, 3=AI Workflow Blueprint
// Storage: Prompts in templates, responses in sessions (JSONB)

// ============================================================================
// TICKET SYSTEM (Sprint 10)
// ============================================================================
// Purpose: Unified WorkItem model for all types of work items
// Types: feature, task, epic, issue, bug, scanner_finding, tech_debt
// Architecture: Single table with `kind` field for type discrimination
// Migration: Issue model renamed to Ticket, existing data gets kind='issue'

model Ticket {
  id Int @id @default(autoincrement())

  // Core fields (inherited from Issue)
  title       String
  description String? @db.Text
  status      String  @default("backlog")
  priority    String  @default("medium")
  module      String? // UI, API, Database, etc.
  assignee    String? // Legacy: simple string assignee

  // Sprint 10: Ticket type system
  kind   String @default("issue") // feature, task, epic, issue, bug, scanner_finding, tech_debt
  source String @default("manual") // manual, onboarding, scanner, agent

  // Sprint 10: Enhanced assignment
  assigneeType String? // human, agent_persona
  assigneeId   String? // User ID or AgentPersona ID

  // Sprint 15: Planning estimate (optional)
  estimatedDays Int? // How many days to complete

  // Custom fields (flexible schema)
  customFields Json? @db.JsonB

  // Full-text search vector (generated column)
  contentSearchVector Unsupported("tsvector")? @map("content_tsv")

  // Relationships
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  labels        Label[]
  comments      TicketComment[]
  attachments   TicketAttachment[]
  linkedFiles   TicketLinkedFile[]
  linkedCommits TicketLinkedCommit[]

  // Knowledge & Wiki links
  linkedKnowledge TicketKnowledgeLink[] @relation("TicketKnowledge")
  linkedWikiPages TicketWikiPageLink[]  @relation("TicketWiki")

  // Security findings
  securityFinding SecurityFinding?

  // Sprint 11.7: Milestone and Due Date
  dueDate     DateTime?
  milestoneId Int?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  // Sprint 13: Two-level ticket hierarchy (Feature → Task/Issue/Bug)
  // Only kind=feature can have children; only task/issue/bug/tech_debt can have parent
  parentTicketId Int?
  parentTicket   Ticket?  @relation("TicketHierarchy", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets   Ticket[] @relation("TicketHierarchy")

  // Sprint 13: Traceability fields for industry workflow (PRD → SRS → Backlog → ProjectPlan)
  epicRef      String?  @db.VarChar(200) // Soft reference: "Epic 1: User Management"
  backlogRefs  String[] @default([]) // SRS traceability: ["FR-001", "FR-002", "NFR-003"]
  sprintNumber Int? // Sprint number for filtering (1, 2, 3, ...)

  // Sprint 15: FK to actual Sprint record (proper relationship for progress calculation)
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  // Sprint 15: Kanban ordering within column
  displayOrder Int @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  closedAt      DateTime?
  HealthFinding HealthFinding?

  // Indexes for performance
  @@index([status])
  @@index([priority])
  @@index([module])
  @@index([projectId])
  @@index([assignee])
  @@index([kind]) // Sprint 10: Filter by ticket type
  @@index([projectId, kind]) // Sprint 10: Project + kind filter
  @@index([projectId, status]) // Sprint 10: Project + status filter
  @@index([kind, status]) // Sprint 10: Kind + status filter
  @@index([createdAt(sort: Desc)])
  @@index([milestoneId]) // Sprint 11.7: Find tickets by milestone
  @@index([dueDate]) // Sprint 11.7: Sort/filter by due date
  @@index([parentTicketId]) // Sprint 13: Find children by parent
  @@index([projectId, parentTicketId]) // Sprint 13: Project-scoped hierarchy queries
  @@index([projectId, sprintNumber]) // Sprint 13: Find tickets by sprint
  @@index([projectId, epicRef]) // Sprint 13: Find tickets by epic reference
  @@index([projectId, sprintNumber, status, displayOrder]) // Sprint 15: Kanban column queries
  @@index([sprintId]) // Sprint 15: FK to Sprint for progress calculation
  @@index([sprintId, status, displayOrder]) // Sprint 15: Kanban board queries by sprintId
  @@map("tickets") // Sprint 10: Renamed from "issues" to "tickets"
}

// ============================================================================
// BACKLOG ITEMS (Sprint 14)
// ============================================================================
// Purpose: Store parsed backlog items for agent-consumable traceability
// Source: Extracted from 12-Backlog.md during traceability validation
// Usage: Agent calls projectpulse_backlog_getBySprint() to get items for ticket creation
// Note: Minimal storage - full details in wiki, this just provides traceability fields

model BacklogItem {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Identity (from parser - matches BacklogItem interface in parsers.ts)
  itemId String @db.VarChar(50) // "US-001" or "Feature 1.1"
  title  String @db.VarChar(300)

  // Traceability fields (for ticket creation)
  epicRef      String?  @db.VarChar(200) // "Epic 1: User Management" (was epicId in parser)
  frTraces     String[] @default([]) // ["FR-001", "FR-002"] - functional requirements
  nfrTraces    String[] @default([]) // ["NFR-001"] - non-functional requirements
  sprintNumber Int? // Sprint assignment (1, 2, 3, ...)

  // Source tracking
  sourceDoc String  @db.VarChar(100) // "12-Backlog.md"
  rawBlock  String? @db.Text // Original markdown block for reference

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints
  @@unique([projectId, itemId])
  @@index([projectId])
  @@index([projectId, sprintNumber])
  @@map("backlog_items")
}

model Label {
  id    Int    @id @default(autoincrement())
  name  String
  color String @default("#808080")

  // Sprint 11.7: Project-scoped labels (was global)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tickets Ticket[] // Sprint 10: Renamed from issues

  createdAt DateTime @default(now())

  @@unique([projectId, name]) // Sprint 11.7: Unique per project, not globally
  @@index([name])
  @@index([projectId])
}

// Sprint 11.7: Milestone model for grouping tickets into releases/versions
model Milestone {
  id          Int       @id @default(autoincrement())
  name        String // e.g., "v1.2.0", "Q1 2025 Release"
  description String?   @db.Text
  targetDate  DateTime? // Target completion date
  status      String    @default("active") // active, completed, cancelled

  // Project scope - milestones belong to a project
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Linked tickets
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name]) // Milestone names unique within project
  @@index([projectId])
  @@index([status])
  @@index([targetDate])
  @@map("milestones")
}

// Sprint 10: Renamed from Comment to TicketComment
model TicketComment {
  id      Int     @id @default(autoincrement())
  content String  @db.Text
  author  String?

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([createdAt(sort: Desc)])
  @@map("ticket_comments") // Sprint 10: Renamed from "comments"
}

// Sprint 10: Renamed from Attachment to TicketAttachment
model TicketAttachment {
  id       Int    @id @default(autoincrement())
  filename String
  filepath String
  mimetype String
  size     Int // bytes

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments") // Sprint 10: Renamed from "attachments"
}

// Sprint 10: Renamed from LinkedFile to TicketLinkedFile
model TicketLinkedFile {
  id         Int    @id @default(autoincrement())
  filePath   String // Relative path from project root
  lineNumber Int?

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ticketId, filePath])
  @@index([filePath])
  @@map("ticket_linked_files") // Sprint 10: Renamed from "linked_files"
}

// Sprint 10: Renamed from LinkedCommit to TicketLinkedCommit
model TicketLinkedCommit {
  id            Int       @id @default(autoincrement())
  commitHash    String // Git commit hash
  commitMessage String?
  commitDate    DateTime?

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ticketId, commitHash])
  @@index([commitHash])
  @@map("ticket_linked_commits") // Sprint 10: Renamed from "linked_commits"
}

// ============================================================================
// KNOWLEDGE BASE
// ============================================================================

model KnowledgeItem {
  id Int @id @default(autoincrement())

  // Sprint 8.9: Project scoping for multi-user isolation
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(200)
  content  String @db.Text
  category String @db.VarChar(50)

  // Tags (array with GIN index for fast filtering)
  tags String[]

  // Vector search (pgvector) - 768 dimensions from Ollama nomic-embed-text
  // NOT NULL for query performance (expert recommendation)
  embedding Unsupported("vector(768)")

  // Full-text search - auto-generated via trigger
  // NOT NULL for query performance (expert recommendation)
  contentTsvector Unsupported("tsvector")

  // Graph relationships
  relationsFrom KnowledgeRelationship[] @relation("FromKnowledge")
  relationsTo   KnowledgeRelationship[] @relation("ToKnowledge")

  // Version history
  versions KnowledgeItemVersion[]

  // Sprint 10: Links to tickets (renamed from linkedIssues)
  linkedTickets TicketKnowledgeLink[] @relation("KnowledgeTicket")

  // Links to skills (US-104: Sprint 6)
  linkedSkills SkillKnowledgeLink[]

  // Ticket #59: Metadata for traceability matrices and other knowledge context
  metadata Json? @db.JsonB

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // Soft delete - archived items hidden from search by default

  // Indexes (note: HNSW vector index created via raw SQL migration)
  @@index([projectId])
  @@index([projectId, category])
  @@index([category])
  @@index([tags], type: Gin)
  @@index([contentTsvector], type: Gin)
  @@index([createdAt(sort: Desc)])
  @@map("knowledge_items")
}

// Sprint 10: Renamed from KnowledgeLink to TicketKnowledgeLink
model TicketKnowledgeLink {
  id Int @id @default(autoincrement())

  knowledgeItemId Int
  knowledgeItem   KnowledgeItem @relation("KnowledgeTicket", fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  ticketId Int
  ticket   Ticket @relation("TicketKnowledge", fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([knowledgeItemId, ticketId])
  @@index([knowledgeItemId])
  @@index([ticketId])
  @@map("ticket_knowledge_links") // Sprint 10: Renamed from "knowledge_links"
}

// Graph relationships between knowledge items (for 2-hop traversal)
model KnowledgeRelationship {
  id Int @id @default(autoincrement())

  fromId Int
  toId   Int

  // Relationship types: RELATES_TO, DEPENDS_ON, CONTRADICTS, EXTENDS, SUPERSEDES
  relationType String @db.VarChar(50)

  // Weight for ranking related items (0.00 to 1.00)
  weight Decimal @default(1.0) @db.Decimal(3, 2)

  createdAt DateTime @default(now())

  // Relationships
  fromKnowledge KnowledgeItem @relation("FromKnowledge", fields: [fromId], references: [id], onDelete: Cascade)
  toKnowledge   KnowledgeItem @relation("ToKnowledge", fields: [toId], references: [id], onDelete: Cascade)

  // Prevent duplicate relationships
  @@unique([fromId, toId, relationType])
  // Indexes for graph traversal performance
  @@index([fromId])
  @@index([toId])
  @@index([relationType])
  @@index([fromId, relationType]) // Composite for filtered traversal
  @@map("knowledge_relationships")
}

// Version history for knowledge items (audit trail)
model KnowledgeItemVersion {
  id Int @id @default(autoincrement())

  itemId  Int
  version Int

  content           String  @db.Text
  changeDescription String? @db.VarChar(500)

  createdAt DateTime @default(now())

  // Relationship
  item KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Unique constraint: one version number per item
  @@unique([itemId, version])
  // Indexes for version queries
  @@index([itemId])
  @@index([itemId, version(sort: Desc)]) // Get latest version efficiently
  @@map("knowledge_item_versions")
}

// Query performance metrics for knowledge base
model KnowledgeQueryMetric {
  id Int @id @default(autoincrement())

  // Query details
  query     String @db.Text
  queryMode String @db.VarChar(20) // 'semantic' | 'fulltext' | 'hybrid'

  // Performance metrics
  latencyMs   Int // Query execution time in milliseconds
  resultCount Int // Number of results returned
  tokenUsage  Int? // Estimated tokens in response (chars / 4)

  // Optional filters applied
  category String? @db.VarChar(50)

  // Client context
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  // Indexes for analytics dashboard
  @@index([queryMode])
  @@index([createdAt(sort: Desc)])
  @@index([queryMode, createdAt(sort: Desc)])
  @@index([latencyMs])
  @@map("knowledge_query_metrics")
}

// ============================================================================
// SKILLS SYSTEM (Sprint 6 - Lazy-Loading)
// ============================================================================
// Purpose: Store AI coding skills (patterns, workflows, SOPs) for lazy-loading
// Token Efficiency: List ~60-80 tokens/10 skills, Load ~180-230 tokens/skill (92% reduction)
// Multi-tenancy: Scoped by projectId for proper isolation

model Skill {
  id Int @id @default(autoincrement())

  // Project association (multi-tenancy)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Core identification (YAML frontmatter fields)
  slug  String @db.VarChar(100) // URL-safe identifier (unique per project)
  title String @db.VarChar(200) // Display name

  // Content (markdown body - NOT loaded in list view)
  content String @db.Text // Skill implementation details, code examples, procedures

  // Frontmatter metadata (loaded in list view for token efficiency)
  category    String   @db.VarChar(50) // framework, testing, workflow, troubleshooting, etc. (extensible)
  description String?  @db.Text // Short summary (1-2 sentences, ~50-100 chars)
  tags        String[] // Keywords for search (e.g., ["react", "hooks", "performance"])
  frameworks  String[] // Related frameworks/tools (e.g., ["Next.js", "Prisma", "Zod"])

  // Usage tracking (for popularity and LRU cache)
  usageCount   Int       @default(0) // Increment on each load
  lastLoadedAt DateTime? // Track last access for auto-unload

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Knowledge links (US-104: Link skills to knowledge items)
  linkedKnowledge SkillKnowledgeLink[]

  // Indexes (7 optimized per Prisma Expert)
  @@unique([projectId, slug]) // Slug unique per project (allows different projects to have same skill names)
  @@index([projectId]) // List all skills for a project
  @@index([projectId, category]) // Filter by category within project
  @@index([projectId, usageCount(sort: Desc)]) // Popular skills dashboard
  @@index([projectId, lastLoadedAt(sort: Desc)]) // Recently loaded skills
  @@index([tags], type: Gin) // Fast tag search (GIN index for arrays)
  @@index([frameworks], type: Gin) // Fast framework search (GIN index for arrays)
  @@map("skills")
}

// Many-to-many relationship: Skills ↔ Knowledge Items
// Purpose: Link skills to relevant knowledge base articles
model SkillKnowledgeLink {
  id Int @id @default(autoincrement())

  skillId    Skill @relation(fields: [skillIdRef], references: [id], onDelete: Cascade)
  skillIdRef Int   @map("skill_id")

  knowledgeId    KnowledgeItem @relation(fields: [knowledgeIdRef], references: [id], onDelete: Cascade)
  knowledgeIdRef Int           @map("knowledge_id")

  createdAt DateTime @default(now())

  @@unique([skillIdRef, knowledgeIdRef])
  @@index([skillIdRef])
  @@index([knowledgeIdRef])
  @@map("skill_knowledge_links")
}

// ============================================================================
// SOPS SYSTEM (Sprint 8.5 Phase 3E)
// ============================================================================
// Purpose: Store Standard Operating Procedures for project-specific workflows
// Multi-tenancy: Scoped by projectId for proper isolation
model SOP {
  id Int @id @default(autoincrement())

  // Project association (multi-tenancy)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Core identification
  title       String @db.VarChar(200) // SOP title
  slug        String @db.VarChar(100) // URL-safe identifier (unique per project)
  description String @db.Text // Short summary (1-2 sentences)

  // Content (markdown)
  content String @db.Text // Full SOP content in markdown format

  // Metadata
  category String   @db.VarChar(50) // Category for grouping (e.g., "Development", "Testing", "Deployment")
  tags     String[] // Keywords for search (e.g., ["git", "workflow", "branching"])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes (5 optimized for common queries)
  @@unique([projectId, slug]) // Slug unique per project
  @@index([projectId]) // List all SOPs for a project
