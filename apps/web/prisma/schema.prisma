// Prisma schema for ProjectPulse (Sprint Tracking System)
// Database: PostgreSQL 16
// Features: JSONB, Full-text search, Vector embeddings, Sprint Hierarchy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SPRINT HIERARCHY (5-LEVEL TASK TRACKING)
// ============================================================================
// Architecture: Adjacency List (FK relationships)
// Progress: Stored field with application-managed roll-up
// Query Strategy: Prisma nested includes for tree traversal

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

model Phase {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent (Sprint 8.5: Link to Roadmap after materialization)
  roadmapId String?
  roadmap   Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  // Hierarchy - Children
  weeks   Week[] // Sprint 8: Week relationship (will be migrated to Sprint → Week in Task 0.3)
  sprints Sprint[] // Sprint 8.5: NEW 5th level - Phase → Sprint → Week → Day → Task

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([roadmapId]) // Sprint 8.5: Query phases by roadmap
  @@index([startDate, endDate])
  @@index([status])
  @@index([startDate, endDate, status])
  @@map("phases")
}

// Sprint 8.5: NEW 5th level in hierarchy (Phase → Sprint → Week → Day → Task)
model Sprint {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  // Hierarchy - Children
  weeks Week[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([phaseId])
  @@index([phaseId, startDate]) // Composite index recommended by prisma-expert
  @@index([startDate, endDate])
  @@index([status])
  @@index([phaseId, status])
  @@index([phaseId, startDate, endDate, status])
  @@map("sprints")
}

model Week {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent
  phaseId String // Sprint 8: Legacy parent (will be removed in Task 0.3 after data migration)
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  sprintId String? // Sprint 8.5: NEW parent (optional during migration, required after Task 0.3)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // Hierarchy - Children
  days Day[]

  // Current Work Tracking (Sprint 8.5 Phase 2)
  currentPlans CurrentPlan[] // Sprint 8.5 Phase 2: Current plans pointing to this week
  currentTodos CurrentTodos[] // Sprint 8.5 Phase 2: Current todos pointing to this week

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([phaseId]) // Sprint 8: Legacy parent (will be removed in Task 0.3)
  @@index([sprintId]) // Sprint 8.5: NEW parent index
  @@index([startDate, endDate])
  @@index([status])
  @@index([phaseId, status]) // Sprint 8: Legacy composite (will be removed in Task 0.3)
  @@index([sprintId, status]) // Sprint 8.5: NEW composite index
  @@index([phaseId, startDate, endDate, status]) // Sprint 8: Legacy (will be removed in Task 0.3)
  @@index([sprintId, startDate, endDate, status]) // Sprint 8.5: NEW full composite
  @@map("weeks")
}

model Day {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent
  weekId String
  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  // Hierarchy - Children
  tasks Task[]

  // Current Work Tracking (Sprint 8.5 Phase 2)
  currentPlans CurrentPlan[] // Sprint 8.5 Phase 2: Current plans pointing to this day
  currentTodos CurrentTodos[] // Sprint 8.5 Phase 2: Current todos pointing to this day

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([weekId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([weekId, status])
  @@index([weekId, startDate, endDate, status])
  @@map("days")
}

model Task {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent
  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  // Hierarchy - Children
  sessions Session[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([dayId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([dayId, status])
  @@index([dayId, startDate, endDate, status])
  @@index([updatedAt(sort: Desc)]) // CRITICAL: For getCurrentTask query (100x faster)
  @@map("tasks")
}

model Session {
  id String @id @default(cuid())

  // Core fields
  title       String
  description String? @db.Text
  status      Status  @default(NOT_STARTED)
  progress    Int     @default(0) // 0-100, validated in application

  // Time window
  startDate DateTime
  endDate   DateTime?

  // Hierarchy - Parent (leaf level, no children)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Checkpoints - Track progress every 15K tokens
  checkpoints Checkpoint[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([taskId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([taskId, status])
  @@index([taskId, startDate, endDate, status])
  @@map("sessions")
}

model Checkpoint {
  id               String   @id @default(cuid())
  sessionId        String
  notes            String   @db.Text
  tokenUsage       Int
  sessionContext   Json?    @db.JsonB
  checkpointNumber Int
  createdAt        DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, checkpointNumber])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@map("checkpoints")
}

// ============================================================================
// USER PREFERENCES (for theme system and future UI preferences)
// ============================================================================

model UserPreferences {
  id     Int  @id @default(autoincrement())
  userId Int? @unique // Optional: will be linked to User model when auth is added

  // Theme preferences
  theme String @default("desert") // "desert", "neon", "earthy", "coral"

  // UI preferences (future)
  sidebarCollapsed Boolean @default(false)
  compactMode      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([theme])
  @@map("user_preferences")
}

// ============================================================================
// CORE ENTITIES: PROJECT & ISSUES
// ============================================================================

model Project {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text
  repository  String? // Git repository URL

  // Sprint 8.9: User ownership
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  issues              Issue[]
  skills              Skill[] // Sprint 6: Skills lazy-loading system
  onboardingSessions  OnboardingSession[]
  workflowRuns        WorkflowRun[]
  workflowTemplates   WorkflowTemplate[] // Sprint 8.5 Phase 3: Project-scoped workflow templates
  healthScanners      HealthScanner[] // Sprint 7: Health monitoring system
  healthScores        HealthScore[] // Sprint 7: Health scores
  roadmap             Roadmap? // Sprint 8.5: Development roadmap (one-to-one)
  developmentSessions DevelopmentSession[] // Sprint 8.5: Agent work tracking (plan + todos for CurrentWorkModal)
  currentPlan         CurrentPlan? // Sprint 8.5 Phase 2: Current work plan
  currentTodos        CurrentTodos? // Sprint 8.5 Phase 2: Current todos list
  agentPersonas       AgentPersona[] // Sprint 8.5 Phase 3: Project-scoped agent personas
  sops                SOP[] // Sprint 8.5 Phase 3E: SOPs for this project
  
  // Sprint 8.9: Additional project-scoped entities
  knowledgeItems      KnowledgeItem[]
  securityFindings    SecurityFinding[]
  wikiPages           WikiPage[]

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  OnboardingPromptTemplate OnboardingPromptTemplate[]

  @@index([name])
  @@index([ownerId])
}

// ============================================================================
// ONBOARDING SYSTEM
// ============================================================================
// Sprint 2 Week 4: 3-session guided project initialization
// Sessions: 1=Executive Summary, 2=Industry Docs, 3=AI Workflow Blueprint
// Storage: Prompts in templates, responses in sessions (JSONB)

model Issue {
  id Int @id @default(autoincrement())

  // Core fields
  title       String
  description String? @db.Text
  status      String  @default("open")
  priority    String  @default("medium")
  module      String? // Combat, Core, UI, Systems, World, Creatures
  assignee    String?

  // Custom fields (flexible schema)
  customFields Json? @db.JsonB

  // Full-text search vector (generated column)
  contentSearchVector Unsupported("tsvector")? @map("content_tsv")

  // Relationships
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  labels        Label[]
  comments      Comment[]
  attachments   Attachment[]
  linkedFiles   LinkedFile[]
  linkedCommits LinkedCommit[]

  // Knowledge & Wiki links
  linkedKnowledge KnowledgeLink[] @relation("IssueKnowledge")
  linkedWikiPages WikiPageLink[]  @relation("IssueWiki")

  // Security findings
  securityFinding SecurityFinding?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  closedAt      DateTime?
  HealthFinding HealthFinding?

  @@index([status])
  @@index([priority])
  @@index([module])
  @@index([projectId])
  @@index([assignee])
  @@index([createdAt(sort: Desc)])
}

model Label {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("#808080")

  issues Issue[]

  createdAt DateTime @default(now())

  @@index([name])
}

model Comment {
  id      Int     @id @default(autoincrement())
  content String  @db.Text
  author  String?

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([createdAt(sort: Desc)])
}

model Attachment {
  id       Int    @id @default(autoincrement())
  filename String
  filepath String
  mimetype String
  size     Int // bytes

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())

  @@index([issueId])
}

model LinkedFile {
  id         Int    @id @default(autoincrement())
  filePath   String // Relative path from project root
  lineNumber Int?

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([issueId, filePath])
  @@index([filePath])
}

model LinkedCommit {
  id            Int       @id @default(autoincrement())
  commitHash    String // Git commit hash
  commitMessage String?
  commitDate    DateTime?

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([issueId, commitHash])
  @@index([commitHash])
}

// ============================================================================
// KNOWLEDGE BASE
// ============================================================================

model KnowledgeItem {
  id Int @id @default(autoincrement())

  // Sprint 8.9: Project scoping for multi-user isolation
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(200)
  content  String @db.Text
  category String @db.VarChar(50)

  // Tags (array with GIN index for fast filtering)
  tags String[]

  // Vector search (pgvector) - 768 dimensions from Ollama nomic-embed-text
  // NOT NULL for query performance (expert recommendation)
  embedding Unsupported("vector(768)")

  // Full-text search - auto-generated via trigger
  // NOT NULL for query performance (expert recommendation)
  contentTsvector Unsupported("tsvector")

  // Graph relationships
  relationsFrom KnowledgeRelationship[] @relation("FromKnowledge")
  relationsTo   KnowledgeRelationship[] @relation("ToKnowledge")

  // Version history
  versions KnowledgeItemVersion[]

  // Links to issues (existing functionality)
  linkedIssues KnowledgeLink[] @relation("KnowledgeIssue")

  // Links to skills (US-104: Sprint 6)
  linkedSkills SkillKnowledgeLink[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // Soft delete - archived items hidden from search by default

  // Indexes (note: HNSW vector index created via raw SQL migration)
  @@index([projectId])
  @@index([projectId, category])
  @@index([category])
  @@index([tags], type: Gin)
  @@index([contentTsvector], type: Gin)
  @@index([createdAt(sort: Desc)])
  @@map("knowledge_items")
}

model KnowledgeLink {
  id Int @id @default(autoincrement())

  knowledgeItemId Int
  knowledgeItem   KnowledgeItem @relation("KnowledgeIssue", fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  issueId Int
  issue   Issue @relation("IssueKnowledge", fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([knowledgeItemId, issueId])
  @@index([knowledgeItemId])
  @@index([issueId])
}

// Graph relationships between knowledge items (for 2-hop traversal)
model KnowledgeRelationship {
  id Int @id @default(autoincrement())

  fromId Int
  toId   Int

  // Relationship types: RELATES_TO, DEPENDS_ON, CONTRADICTS, EXTENDS, SUPERSEDES
  relationType String @db.VarChar(50)

  // Weight for ranking related items (0.00 to 1.00)
  weight Decimal @default(1.0) @db.Decimal(3, 2)

  createdAt DateTime @default(now())

  // Relationships
  fromKnowledge KnowledgeItem @relation("FromKnowledge", fields: [fromId], references: [id], onDelete: Cascade)
  toKnowledge   KnowledgeItem @relation("ToKnowledge", fields: [toId], references: [id], onDelete: Cascade)

  // Prevent duplicate relationships
  @@unique([fromId, toId, relationType])
  // Indexes for graph traversal performance
  @@index([fromId])
  @@index([toId])
  @@index([relationType])
  @@index([fromId, relationType]) // Composite for filtered traversal
  @@map("knowledge_relationships")
}

// Version history for knowledge items (audit trail)
model KnowledgeItemVersion {
  id Int @id @default(autoincrement())

  itemId  Int
  version Int

  content           String  @db.Text
  changeDescription String? @db.VarChar(500)

  createdAt DateTime @default(now())

  // Relationship
  item KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Unique constraint: one version number per item
  @@unique([itemId, version])
  // Indexes for version queries
  @@index([itemId])
  @@index([itemId, version(sort: Desc)]) // Get latest version efficiently
  @@map("knowledge_item_versions")
}

// Query performance metrics for knowledge base
model KnowledgeQueryMetric {
  id Int @id @default(autoincrement())

  // Query details
  query     String @db.Text
  queryMode String @db.VarChar(20) // 'semantic' | 'fulltext' | 'hybrid'

  // Performance metrics
  latencyMs   Int // Query execution time in milliseconds
  resultCount Int // Number of results returned
  tokenUsage  Int? // Estimated tokens in response (chars / 4)

  // Optional filters applied
  category String? @db.VarChar(50)

  // Client context
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  // Indexes for analytics dashboard
  @@index([queryMode])
  @@index([createdAt(sort: Desc)])
  @@index([queryMode, createdAt(sort: Desc)])
  @@index([latencyMs])
  @@map("knowledge_query_metrics")
}

// ============================================================================
// SKILLS SYSTEM (Sprint 6 - Lazy-Loading)
// ============================================================================
// Purpose: Store AI coding skills (patterns, workflows, SOPs) for lazy-loading
// Token Efficiency: List ~60-80 tokens/10 skills, Load ~180-230 tokens/skill (92% reduction)
// Multi-tenancy: Scoped by projectId for proper isolation

model Skill {
  id Int @id @default(autoincrement())

  // Project association (multi-tenancy)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Core identification (YAML frontmatter fields)
  slug  String @db.VarChar(100) // URL-safe identifier (unique per project)
  title String @db.VarChar(200) // Display name

  // Content (markdown body - NOT loaded in list view)
  content String @db.Text // Skill implementation details, code examples, procedures

  // Frontmatter metadata (loaded in list view for token efficiency)
  category    String   @db.VarChar(50) // framework, testing, workflow, troubleshooting, etc. (extensible)
  description String?  @db.Text // Short summary (1-2 sentences, ~50-100 chars)
  tags        String[] // Keywords for search (e.g., ["react", "hooks", "performance"])
  frameworks  String[] // Related frameworks/tools (e.g., ["Next.js", "Prisma", "Zod"])

  // Usage tracking (for popularity and LRU cache)
  usageCount   Int       @default(0) // Increment on each load
  lastLoadedAt DateTime? // Track last access for auto-unload

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Knowledge links (US-104: Link skills to knowledge items)
  linkedKnowledge SkillKnowledgeLink[]

  // Indexes (7 optimized per Prisma Expert)
  @@unique([projectId, slug]) // Slug unique per project (allows different projects to have same skill names)
  @@index([projectId]) // List all skills for a project
  @@index([projectId, category]) // Filter by category within project
  @@index([projectId, usageCount(sort: Desc)]) // Popular skills dashboard
  @@index([projectId, lastLoadedAt(sort: Desc)]) // Recently loaded skills
  @@index([tags], type: Gin) // Fast tag search (GIN index for arrays)
  @@index([frameworks], type: Gin) // Fast framework search (GIN index for arrays)
  @@map("skills")
}

// Many-to-many relationship: Skills ↔ Knowledge Items
// Purpose: Link skills to relevant knowledge base articles
model SkillKnowledgeLink {
  id Int @id @default(autoincrement())

  skillId    Skill @relation(fields: [skillIdRef], references: [id], onDelete: Cascade)
  skillIdRef Int   @map("skill_id")

  knowledgeId    KnowledgeItem @relation(fields: [knowledgeIdRef], references: [id], onDelete: Cascade)
  knowledgeIdRef Int           @map("knowledge_id")

  createdAt DateTime @default(now())

  @@unique([skillIdRef, knowledgeIdRef])
  @@index([skillIdRef])
  @@index([knowledgeIdRef])
  @@map("skill_knowledge_links")
}

// ============================================================================
// SOPS SYSTEM (Sprint 8.5 Phase 3E)
// ============================================================================
// Purpose: Store Standard Operating Procedures for project-specific workflows
// Multi-tenancy: Scoped by projectId for proper isolation
model SOP {
  id Int @id @default(autoincrement())

  // Project association (multi-tenancy)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Core identification
  title       String @db.VarChar(200) // SOP title
  slug        String @db.VarChar(100) // URL-safe identifier (unique per project)
  description String @db.Text // Short summary (1-2 sentences)

  // Content (markdown)
  content String @db.Text // Full SOP content in markdown format

  // Metadata
  category String   @db.VarChar(50) // Category for grouping (e.g., "Development", "Testing", "Deployment")
  tags     String[] // Keywords for search (e.g., ["git", "workflow", "branching"])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes (5 optimized for common queries)
  @@unique([projectId, slug]) // Slug unique per project
  @@index([projectId]) // List all SOPs for a project
  @@index([projectId, category]) // Filter by category within project
  @@index([tags], type: Gin) // Fast tag search (GIN index for arrays)
  @@map("sops")
}

// ============================================================================
// DOCUMENTATION WIKI
// ============================================================================

model WikiPage {
  id Int @id @default(autoincrement())

  // Sprint 8.9: Project scoping for multi-user isolation
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title   String
  content String  @db.Text
  excerpt String? @db.Text // Short description for list views

  // Added field
  category String?

  // Hierarchical structure
  parentId Int?
  parent   WikiPage?  @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children WikiPage[] @relation("PageHierarchy")

  // URL path (e.g., /rules/combat/fsm-authority)
  path       String @unique
  orderIndex Int    @default(0)

  // Full-text search (will be populated by triggers)
  searchVector String? @db.Text // Using Text as placeholder for tsvector

  // Links
  outgoingLinks PageLink[] @relation("SourcePage")
  incomingLinks PageLink[] @relation("TargetPage")

  // Issue links
  linkedIssues WikiPageLink[] @relation("WikiIssue")

  // Version history (simplified - Phase 3)
  version Int @default(1)

  // New fields for wiki detail page enhancement
  views        Int       @default(0)
  revisions    Int       @default(1)
  contributors Json      @default("[]")
  readingTime  Int?
  tags         String[]  @default([])
  lastEditedBy String?
  lastEditedAt DateTime?
  isLocked     Boolean   @default(false)

  // Auto-generation fields (US-107)
  autoGenerated Boolean  @default(false) // True if generated from JSDoc
  sourceFiles   String[] @default([]) // Source file paths for auto-generated pages

  // Relations
  revisionEntries WikiRevision[]
  events          WikiPageEvent[]
  analytics       WikiPageAnalytics?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, path])
  @@index([projectId, category])
  @@index([path])
  @@index([parentId])
  @@index([orderIndex])
  @@index([category])
  @@index([views(sort: Desc)])
  @@index([category, orderIndex])
  @@index([autoGenerated])
  @@index([category, id]) // For prev/next page queries (findFirst with category + id comparison)
}

model WikiRevision {
  id         Int      @id @default(autoincrement())
  wikiPageId Int
  wikiPage   WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)

  version     Int
  title       String
  excerpt     String? @db.Text
  content     String  @db.Text
  diffSummary String? @db.Text

  createdBy     String
  createdByType String   @default("agent") // agent | human | system
  createdAt     DateTime @default(now())

  @@unique([wikiPageId, version])
  @@index([wikiPageId, version])
}

model PageLink {
  id Int @id @default(autoincrement())

  sourcePageId Int
  sourcePage   WikiPage @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)

  targetPageId Int
  targetPage   WikiPage @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  linkType String? // 'reference', 'related', 'example'

  createdAt DateTime @default(now())

  @@unique([sourcePageId, targetPageId])
  @@index([sourcePageId])
  @@index([targetPageId])
}

model WikiPageLink {
  id Int @id @default(autoincrement())

  wikiPageId Int
  wikiPage   WikiPage @relation("WikiIssue", fields: [wikiPageId], references: [id], onDelete: Cascade)

  issueId Int
  issue   Issue @relation("IssueWiki", fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wikiPageId, issueId])
  @@index([wikiPageId])
  @@index([issueId])
}

model WikiPageEvent {
  id         BigInt   @id @default(autoincrement())
  wikiPageId Int
  wikiPage   WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)

  type       WikiEventType
  actor      String?
  durationMs Int?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([wikiPageId, createdAt])
  @@index([type])
}

model WikiPageAnalytics {
  id         Int      @id @default(autoincrement())
  wikiPageId Int      @unique
  wikiPage   WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)

  viewCount      Int      @default(0)
  uniqueVisitors Int      @default(0)
  avgReadTimeMs  Int      @default(0)
  positiveVotes  Int      @default(0)
  negativeVotes  Int      @default(0)
  popularity     Float    @default(0)
  trend          Float    @default(0)
  refreshedAt    DateTime @default(now())
