// ============================================================================
// DOCUMENT STORAGE (Sprint 8.5 Phase 1)
// ============================================================================
// Purpose: Store Session 2 generated documents (15 industry docs)
// Storage: Markdown content in Document table (NOT files in repo)
// Usage: Session 2 calls MCP → saves docs → Session 3 parses 13-Project-Plan.md

model Document {
  id                  String            @id @default(cuid())
  onboardingSessionId Int // ✅ CRITICAL FIX: Int matches OnboardingSession.id (was String in draft)
  onboardingSession   OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  // Document details
  filename    String // "01-PRD.md", "13-Project-Plan.md"
  content     String   @db.Text // Full markdown content (Session 2 generates this, ~100KB total for 15 docs)
  wordCount   Int // Word count for analytics
  generatedAt DateTime @default(now()) // When document was generated

  // Wiki integration and categorization
  category String? // "planning" | "architecture" | "implementation" | "operations"
  tags     String[] @default([]) // Keywords for search

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([onboardingSessionId, filename]) // Prevent duplicate filenames per session
  // Performance indexes
  @@index([onboardingSessionId]) // List documents for session
  @@index([filename]) // Search by filename (Session 3 needs this)
  @@map("documents")
}

// ============================================================================
// DEVELOPMENT ROADMAP (Sprint 8.5 Phase 1)
// ============================================================================
// Purpose: Store parsed roadmap structure as JSON before materialization
// Flow: Session 3 parses 13-Project-Plan.md → creates Roadmap JSON → materializes to Phase/Sprint/Week/Day
// 5-Level Hierarchy: Phase → Sprint → Week → Day → Task

model Roadmap {
  id        String  @id @default(cuid())
  projectId Int     @unique // ✅ CRITICAL: Int to match Project.id (not String)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Nested JSON structure with phases → sprints → weeks
  // Example: { "phases": [ { "name": "Phase A", "sprints": [ { "name": "Sprint 1", "weeks": "Weeks 1-2", ... } ] } ] }
  phases Json @db.JsonB

  // Current position tracking (string references to entities)
  currentPhase  String? // "Phase A: Foundation"
  currentSprint String? // "Sprint 2: Wiki System"
  currentWeek   String? // "Week 4"
  currentDay    String? // "Tuesday"

  // Relationships
  phases_rel Phase[] // After materialization: Roadmap → Phase[] (one-to-many)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance indexes
  // Note: GIN index for JSONB will be created via raw SQL migration (Prisma limitation)
  // See migration file: CREATE INDEX roadmaps_phases_gin_idx ON roadmaps USING GIN (phases);
  @@map("roadmaps")
}

