{
  "$schema": "https://modelcontextprotocol.io/schemas/config.json",
  "description": "MCP configuration for ProjectPulse - Connects Claude Code to ProjectPulse knowledge base and tools",
  "mcpServers": {
    "projectpulse": {
      "transport": "http",
      "url": "http://192.168.1.15:3000/api/mcp",
      "description": "ProjectPulse MCP Server - Knowledge base, tools, and resources for AI-assisted development",
      "timeout": 30000,
      "headers": {
        "Content-Type": "application/json"
      },
      "capabilities": {
        "tools": true,
        "resources": true
      },
      "metadata": {
        "version": "1.0.0",
        "environment": "development",
        "network": "local"
      }
    }
  },
  "notes": {
    "setup": [
      "1. Ensure ProjectPulse Next.js server is running at http://192.168.1.15:3000",
      "2. Verify database is seeded with knowledge items",
      "3. Test connection: curl -X POST http://192.168.1.15:3000/api/mcp -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}'",
      "4. Add this config to Claude Code: ~/.config/claude-code/mcp.json (Linux/Mac) or %APPDATA%/claude-code/mcp.json (Windows)"
    ],
    "tools": [
      "knowledge.search - Hybrid semantic + full-text search across knowledge base",
      "knowledge.create - Create new knowledge items with automatic embeddings",
      "knowledge.related - Find related items via graph traversal (1-2 hops)"
    ],
    "resources": [
      "knowledge://item/{id} - Read specific knowledge item with metadata and relationships",
      "Use resources/list to discover available items"
    ],
    "architecture": {
      "transport": "HTTP (Streamable HTTP 2025-03-26 spec)",
      "session_management": "Mcp-Session-Id header with 1-hour TTL",
      "authentication": "None (local network only - OAuth 2.1 for cloud)",
      "error_handling": "JSON-RPC 2.0 error codes with detailed error data"
    },
    "examples": {
      "tool_invocation": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "knowledge.search",
          "arguments": {
            "query": "PostgreSQL indexing",
            "mode": "hybrid",
            "limit": 5
          }
        }
      },
      "resource_read": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "resources/read",
        "params": {
          "uri": "knowledge://item/4"
        }
      }
    }
  }
}
