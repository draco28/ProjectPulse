# ============================================
# ProjectPulse Production Environment
# Mac Mini Local Deployment
# ============================================
# Copy this file to .env.prod-local and fill in values
# NEVER commit .env.prod-local to git!
# ============================================

# ============================================
# Database Configuration
# ============================================
# Use strong passwords (32+ characters recommended)
# Generate with: openssl rand -base64 32
PROD_POSTGRES_USER=projectpulse
PROD_POSTGRES_PASSWORD=<generate-strong-password-here>
PROD_POSTGRES_DB=projectpulse_prod

# ============================================
# Redis Configuration
# ============================================
# Use strong password for Redis
# Generate with: openssl rand -base64 32
PROD_REDIS_PASSWORD=<generate-strong-password-here>

# ============================================
# NextAuth Configuration
# ============================================
# Secret for session encryption
# Generate with: openssl rand -base64 32
PROD_NEXTAUTH_SECRET=<generate-secret-here>

# ============================================
# Public URL
# ============================================
# This will be your Cloudflare Tunnel URL after setup
# Temporary: https://<random>.trycloudflare.com
# Custom domain: https://projectpulse.yourdomain.com
PROD_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# ============================================
# Cloudflare Tunnel
# ============================================
# Get this from Cloudflare Zero Trust Dashboard:
# 1. Go to Access > Tunnels
# 2. Create new tunnel named "projectpulse-prod"
# 3. Copy the tunnel token
CLOUDFLARE_TUNNEL_TOKEN=<your-tunnel-token>

# ============================================
# Application Settings
# ============================================
# Default project ID for new users
PROD_DEFAULT_PROJECT_ID=1

# ============================================
# Optional: Custom Domain (Future)
# ============================================
# PROD_DOMAIN=projectpulse.yourdomain.com
