{
  "root": true,
  "extends": ["eslint:recommended"],
  "env": {
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/",
    "**/node_modules/",
    "**/.next/",
    "**/dist/",
    "**/build/",
    "**/coverage/",
    "**/playwright-report/",
    "**/test-results/",
    "**/*.d.ts"
  ]
}
