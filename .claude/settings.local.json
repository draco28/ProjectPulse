{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(for file in system-patterns.md tech-context.md active-context.md progress.md)",
      "Bash(do wc -l \"F:/Web_Projects/AI_HUB/.agent/$file\")",
      "Bash(done)",
      "Bash(for file in api-catalog.md component-patterns.md database-schema.md mcp-tools-guide.md memory-mcp-strategy.md)",
      "Bash(do echo \"=== $file ===\")",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(for file in next-js-expert.md react-expert.md prisma-expert.md)",
      "Bash(do)"
    ],
    "deny": [],
    "ask": [
      "Bash(docker-compose down:*)",
      "Bash(pnpm remove:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(git push:*)"
    ]
  },
  "outputStyle": "Explanatory",
  "settings": {
    "project_name": "ProjectPulse (AI_HUB)",
    "default_agent": "devhub-architect",
    "auto_save_session": true,
    "verbose_routing": true
  }
}
