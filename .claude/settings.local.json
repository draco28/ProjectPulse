{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(for file in system-patterns.md tech-context.md active-context.md progress.md)",
      "Bash(do wc -l \"F:/Web_Projects/AI_HUB/.agent/$file\")",
      "Bash(done)",
      "Bash(for file in api-catalog.md component-patterns.md database-schema.md mcp-tools-guide.md memory-mcp-strategy.md)",
      "Bash(do echo \"=== $file ===\")",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(for file in next-js-expert.md react-expert.md prisma-expert.md)",
      "Bash(do)",
      "mcp__sequential-thinking__sequentialthinking",
      "Bash(test:*)",
      "mcp__filesystem__read_text_file",
      "mcp__filesystem__edit_file",
      "Bash(pnpm test:*)",
      "Bash(pnpm dev:*)",
      "Bash(timeout 15 bash:*)",
      "Bash(curl:*)",
      "Bash(node -e:*)",
      "Bash(pnpm --version:*)",
      "Bash(npx husky:*)",
      "Bash(npm run build:*)",
      "Bash(docker-compose restart:*)",
      "Bash(docker ps:*)",
      "Bash(docker port:*)",
      "Bash(docker-compose up:*)",
      "Bash(timeout 5 bash -c \"echo > /dev/tcp/127.0.0.1/5432\")",
      "Bash(docker inspect:*)",
      "Bash(wsl -d Ubuntu-24.04 -- bash -c:*)",
      "Bash(wsl -d Ubuntu-24.04 -- cat:*)",
      "Bash(npm install)",
      "Bash(pnpm build:*)",
      "Bash(pnpm install)",
      "Bash(yes:*)",
      "Bash(git mv:*)",
      "Bash(git reset:*)",
      "Bash(time rg:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(docker-compose down:*)",
      "Bash(pnpm remove:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(git push:*)"
    ]
  },
  "outputStyle": "Explanatory",
  "settings": {
    "project_name": "ProjectPulse (AI_HUB)",
    "default_agent": "devhub-architect",
    "auto_save_session": true,
    "verbose_routing": true
  }
}
