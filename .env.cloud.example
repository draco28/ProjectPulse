# Docker Compose Cloud Environment (Development)
# Copy to .env.cloud and modify as needed
# All values have defaults - only override what you want to change
#
# Usage: docker compose --env-file .env.cloud -f docker-compose.cloud.yml up -d
# Or set environment variables directly in your shell

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL password for the projectpulse_dev database
# Default: postgres123
POSTGRES_PASSWORD=your-custom-password

# =============================================================================
# REDIS
# =============================================================================
# Redis authentication password
# Default: devredis123
REDIS_PASSWORD=your-custom-redis-password

# =============================================================================
# AUTHENTICATION
# =============================================================================
# NextAuth.js secret for session signing (must be 32+ characters)
# Default: dev-secret-change-in-production
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-for-development

# =============================================================================
# MCP INTERNAL
# =============================================================================
# Secret for internal MCP server authentication (must be 32+ characters)
# Default: dev-mcp-secret-32-chars-minimum-ok
# Generate with: openssl rand -hex 32
MCP_INTERNAL_SECRET=your-32-char-mcp-secret-minimum

# =============================================================================
# CORS (Optional)
# =============================================================================
# Comma-separated list of allowed origins for browser-based MCP clients
# Default: empty (no browser CORS)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
